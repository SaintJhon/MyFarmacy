@model IEnumerable<SistemaFarmacia.DTOs.Producto.ProductoDTO>

@{
    ViewData["Title"] = "Panel de Productos";
    string rol = Context.Session.GetString("Rol") ?? "Cliente";
}

<div class="container mt-4">
    <h2>Sistema de Farmacia - Panel Principal</h2>
    <hr />

    <div class="alert alert-info">
        Sesión activa con el rol: <strong>@rol</strong>
    </div>

    @if (rol == "Administrador" || rol == "Empleado")
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-success text-white">
                Registrar Nuevo Producto
            </div>

            <div class="card-body">

                <form asp-action="Create"
                      asp-controller="Productos"
                      method="post"
                      class="row g-3">

                    <div class="col-md-3">
                        <input type="text"
                               name="CodigoBarras"
                               class="form-control"
                               placeholder="Código"
                               required />
                    </div>

                    <div class="col-md-3">
                        <input type="text"
                               name="Nombre"
                               class="form-control"
                               placeholder="Nombre"
                               required />
                    </div>

                    <div class="col-md-4">
                        <input type="text"
                               name="Descripcion"
                               class="form-control"
                               placeholder="Descripción" />
                    </div>

                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-success w-100">
                            Guardar
                        </button>
                    </div>

                    <div class="col-md-3">
                        <input type="number"
                               name="PrecioVenta"
                               class="form-control"
                               placeholder="Precio"
                               step="0.01"
                               required />
                    </div>

                    <div class="col-md-3">
                        <input type="date"
                               name="FechaVencimiento"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6">
                        <input type="text"
                               name="IdProveedor"
                               class="form-control"
                               placeholder="Id del proveedor" />
                    </div>

                </form>

            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            Inventario de Productos
        </div>

        <div class="card-body">

            <table class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>

                        @if (rol == "Administrador")
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.CodigoBarras</td>
                                <td>@item.Nombre</td>
                                <td>@item.Descripcion</td>

                                @if (rol == "Administrador")
                                {
                                    <td>

                                        <a asp-action="Edit"
                                           asp-controller="Productos"
                                           asp-route-id="@item.Id"
                                           class="btn btn-primary btn-sm">
                                            Editar
                                        </a>

                                        <form asp-action="Delete"
                                              asp-controller="Productos"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('¿Está seguro de eliminar este producto?');">
                                                Eliminar
                                            </button>

                                        </form>

                                    </td>
                                }

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(rol == "Administrador" ? 5 : 4)"
                                class="text-center text-muted">
                                No hay productos registrados, usar el formulario
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index"
           asp-controller="Home"
           class="btn btn-secondary">
            Cerrar Sesión
        </a>
    </div>

</div>